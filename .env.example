# ─────────────────────────────────────────────────────────────────────────────
# PrepFlows — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase connection strings — find in: Project Settings → Database
# Use the "Transaction" pooler URL for the API server (better connection limits)
SUPABASE_POOLER_URL=postgresql://postgres.your-project:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Direct connection — used for Drizzle migrations only
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Expo mobile app (public — safe to bundle, Supabase security relies on RLS) ─
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── API Server ───────────────────────────────────────────────────────────────
# Port the Express API listens on (Replit sets this automatically)
PORT=8080

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-char-string

# ── Stripe ───────────────────────────────────────────────────────────────────
# Find these in: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Used by the Expo app for Stripe Elements / Payment Sheet
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── OpenAI (optional — Smart Import falls back to rule-based parsing if absent) ─
OPENAI_API_KEY=sk-...

# ── EAS / Expo (CI only — not needed locally) ────────────────────────────────
EXPO_TOKEN=your-eas-token
